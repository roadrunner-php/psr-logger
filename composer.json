{
    "name": "roadrunner/psr-logger",
    "type": "library",
    "description": "PSR-3 logger that forwards application logs to the RoadRunner app-logger plugin over RPC",
    "keywords": [
        "roadrunner",
        "psr-3",
        "psr",
        "logger",
        "logging",
        "log",
        "rpc"
    ],
    "license": "MIT",
    "authors": [
        {
            "name": "Anton Titov",
            "homepage": "https://github.com/wolfy-j"
        },
        {
            "name": "Aleksei Gagarin",
            "homepage": "https://github.com/roxblnfk"
        },
        {
            "name": "Pavel Buchnev",
            "homepage": "https://github.com/butschster"
        },
        {
            "name": "RoadRunner Community",
            "homepage": "https://github.com/roadrunner-php/psr-logger/graphs/contributors"
        }
    ],
    "homepage": "https://roadrunner.dev/",
    "support": {
        "docs": "https://docs.roadrunner.dev/docs/logging-and-observability/applogger",
        "issues": "https://github.com/roadrunner-php/psr-logger/issues",
        "source": "https://github.com/roadrunner-php/psr-logger",
        "chat": "https://discord.gg/V6EK4he"
    },
    "require": {
        "php": ">=8.2",
        "ext-json": "*",
        "psr/log": "^2.0 || ^3.0",
        "roadrunner/app-logger": "^1.3"
    },
    "require-dev": {
        "buggregator/trap": "^1.13",
        "spiral/code-style": "^2.3.1",
        "symfony/polyfill-php83": "*",
        "testo/testo": "^0.10.55",
        "vimeo/psalm": "^6 || ^7"
    },
    "scripts": {
        "cs:diff": "php-cs-fixer fix --dry-run -v --diff",
        "cs:fix": "php-cs-fixer fix -v",
        "test": "testo",
        "psalm": "psalm"
    },
    "autoload": {
        "psr-4": {
            "RoadRunner\\PsrLogger\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "RoadRunner\\PsrLogger\\Tests\\": "tests"
        }
    },
    "funding": [
        {
            "type": "github",
            "url": "https://github.com/sponsors/roadrunner-server"
        }
    ],
    "config": {
        "sort-packages": true,
        "audit": {
            "ignore": {
                "GHSA-g9pc-8g42-g6vq": "False positive: the range < 2025.1.0 also matches RoadRunner 3.x, which is not affected"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
